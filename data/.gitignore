runtime/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 配置写盘备份
*.backup.*
*.backup

# QQBot 等按 schema 生成的本机配置
QQBot.json

# 审计 / 控制台落盘
ai-console/audit/
