      "apis": [
        {
          "id": "data-read",
          "method": "GET",
          "path": "/api/data/read",
          "title": "读取数据文件",
          "description": "读取 JSON / YAML / 文本文件内容（带基础元信息）",
          "queryParams": [
            {
              "name": "filePath",
              "label": "文件路径",
              "type": "text",
              "required": true,
              "placeholder": "core/system-Core/www/xrk/api-config.json",
              "defaultValue": "core/system-Core/www/xrk/api-config.json"
            },
            {
              "name": "encoding",
              "label": "编码",
              "type": "text",
              "placeholder": "utf8",
              "defaultValue": "utf8"
            }
          ]
        },
        {
          "id": "data-write",
          "method": "POST",
          "path": "/api/data/write",
          "title": "写入数据文件",
          "description": "写入或合并 JSON / YAML 数据文件（支持 overwrite/merge/append/update）",
          "bodyParams": [
            {
              "name": "filePath",
              "label": "文件路径",
              "type": "text",
              "required": true,
              "placeholder": "core/system-Core/www/xrk/api-config.json",
              "defaultValue": "core/system-Core/www/xrk/api-config.json"
            },
            {
              "name": "data",
              "label": "写入数据",
              "type": "json",
              "required": true,
              "placeholder": "{\"key\": \"value\"}",
              "defaultValue": {
                "demo": true
              }
            },
            {
              "name": "operation",
              "label": "写入操作",
              "type": "select",
              "options": [
                {
                  "value": "overwrite",
                  "label": "覆盖"
                },
                {
                  "value": "merge",
                  "label": "深度合并"
                },
                {
                  "value": "append",
                  "label": "追加数组"
                },
                {
                  "value": "update",
                  "label": "按 path 更新"
                }
              ],
              "defaultValue": "merge"
            },
            {
              "name": "path",
              "label": "（仅 update 时）目标路径",
              "type": "text",
              "placeholder": "apiGroups.0.title",
              "defaultValue": "apiGroups.0.title"
            },
            {
              "name": "backup",
              "label": "写入前备份原文件",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是"
                },
                {
                  "value": "false",
                  "label": "否"
                }
              ],
              "defaultValue": "true"
            }
          ]
        }
      ]
    }
