          "queryParams": [
            {
              "name": "workspace",
              "label": "工作区",
              "type": "text",
              "defaultValue": "default",
              "placeholder": "default"
            }
          ]
        },
        {
          "id": "ai-workspace-agents-put",
          "method": "PUT",
          "path": "/api/ai/workspace/agents",
