          "pathParams": {
            "name": {
              "label": "提示词名称",
              "placeholder": "example",
              "defaultValue": "example"
            }
          },
          "bodyParams": [
            {
              "name": "arguments",
              "label": "提示词参数",
              "type": "json",
              "placeholder": "{\"user\": \"demo\"}",
              "defaultValue": {
                "user": "demo"
              }
            }
