            },
            {
              "name": "method",
              "label": "方法",
              "type": "text",
              "required": true,
              "defaultValue": "rpc.discover",
              "placeholder": "tools/list"
            },
            {
              "name": "params",
              "label": "参数",
              "type": "json",
              "defaultValue": {}
            }
          ]
        },
        {
          "id": "mcp-tools",
          "method": "GET",
          "path": "/api/mcp/tools",
          "title": "工具列表",
          "description": "获取所有 MCP 工具列表",
          "queryParams": [
            {
              "name": "stream",
              "label": "工作流过滤",
              "type": "text",
              "placeholder": "chat",
              "defaultValue": "chat"
            }
          ]
        },
        {
          "id": "mcp-tools-streams",
          "method": "GET",
          "path": "/api/mcp/tools/workflows",
          "title": "工具分组",
          "description": "按工作流分组获取工具列表"
        },
        {
          "id": "mcp-tools-stream-detail",
          "method": "GET",
          "path": "/api/mcp/tools/workflow/:workflowName",
          "title": "指定工作流工具",
          "description": "查看某个工作流下可用的工具列表",
          "pathParams": {
            "workflowName": {
              "label": "工作流名称",
              "placeholder": "chat",
              "defaultValue": "chat"
            }
          }
        },
        {
          "id": "mcp-tools-call",
          "method": "POST",
          "path": "/api/mcp/tools/call",
          "title": "调用工具",
          "description": "调用指定的 MCP 工具",
          "bodyParams": [
            {
              "name": "name",
              "label": "工具名称",
              "type": "text",
              "required": true,
              "placeholder": "chat.screenshot",
              "defaultValue": "chat.screenshot"
            },
            {
              "name": "arguments",
              "label": "工具参数",
              "type": "json",
              "placeholder": "{}",
              "defaultValue": {
                "prompt": "当前屏幕截图"
              }
            }
          ]
        },
        {
          "id": "mcp-tool-detail",
          "method": "GET",
          "path": "/api/mcp/tools/:name",
          "title": "单个工具详情",
          "description": "查看指定 MCP 工具的描述与入参 Schema",
          "pathParams": {
            "name": {
              "label": "工具名称",
              "placeholder": "chat.screenshot",
              "defaultValue": "chat.screenshot"
            }
          }
        },
        {
          "id": "mcp-resources",
          "method": "GET",
          "path": "/api/mcp/resources",
          "title": "资源列表",
          "description": "列出 MCP 暴露的所有资源"
        },
        {
          "id": "mcp-resource-read",
          "method": "GET",
          "path": "/api/mcp/resources/:uri",
          "title": "读取资源",
