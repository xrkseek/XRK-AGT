          "queryParams": [
            {
              "name": "workspace",
              "label": "工作区",
              "type": "text",
              "defaultValue": "default",
              "placeholder": "default"
            },
            {
              "name": "path",
              "label": "相对路径",
              "type": "text",
              "required": true,
              "defaultValue": "AGENTS.md",
              "placeholder": "AGENTS.md"
            }
          ]
        },
        {
          "id": "ai-workspace-agents-get",
          "method": "GET",
          "path": "/api/ai/workspace/agents",
