{
  "apiGroups": [
    {
      "id": "core",
      "title": "核心系统",
      "apis": [
        {
          "id": "system-auth-mode",
          "method": "GET",
          "path": "/api/system/auth-mode",
          "title": "鉴权模式",
          "description": "公开：是否要求 API Key（requiresKey），控制台用此接口而非 401 探测"
        },
        {
          "id": "system-status",
          "method": "GET",
          "path": "/api/status",
          "title": "系统状态",
          "description": "获取系统运行状态、机器人信息和适配器列表"
        },
        {
          "id": "system-status-detail",
          "method": "GET",
          "path": "/api/system/status",
          "title": "系统状态详情",
          "description": "获取系统状态详细信息"
        },
        {
          "id": "system-overview",
          "method": "GET",
          "path": "/api/system/overview",
          "title": "系统概览",
          "description": "获取仪表盘面板、工作流与网络统计数据",
          "queryParams": [
            {
              "name": "withHistory",
              "label": "包含历史网络数据",
              "type": "select",
              "options": [
                {
                  "value": "0",
                  "label": "否"
                },
                {
                  "value": "1",
                  "label": "是"
                }
              ],
              "defaultValue": "1"
            }
          ]
        },
        {
          "id": "system-config",
          "method": "GET",
          "path": "/api/config",
          "title": "系统配置",
          "description": "运行时配置缓存快照（port + configs）"
        },
        {
          "id": "health-check",
          "method": "GET",
          "path": "/api/health",
          "title": "健康检查",
          "description": "检查系统各服务的健康状态"
        }
      ]
    },
    {
      "id": "bot",
      "title": "机器人管理",
      "apis": [
        {
          "id": "bot-list",
          "method": "GET",
          "path": "/api/bots",
          "title": "机器人列表",
          "description": "获取所有已连接的机器人",
          "queryParams": [
            {
              "name": "includeDevices",
              "label": "包含设备",
              "type": "select",
              "options": [
                {
                  "value": "0",
                  "label": "否"
                },
                {
                  "value": "1",
                  "label": "是"
                }
              ],
              "defaultValue": "0"
            }
          ]
        },
        {
          "id": "bot-friends",
          "method": "GET",
          "path": "/api/bot/:uin/friends",
          "title": "好友列表",
          "description": "获取指定机器人的好友列表",
          "pathParams": {
            "uin": {
              "label": "机器人UIN",
              "placeholder": "123456789",
              "defaultValue": "123456789"
            }
          }
        },
        {
          "id": "bot-groups",
          "method": "GET",
          "path": "/api/bot/:uin/groups",
          "title": "群组列表",
          "description": "获取指定机器人的群组列表",
          "pathParams": {
            "uin": {
              "label": "机器人UIN",
              "placeholder": "123456789",
              "defaultValue": "123456789"
            }
          }
        },
        {
          "id": "bot-control",
          "method": "POST",
          "path": "/api/bot/:uin/control",
          "title": "控制机器人",
          "description": "执行机器人控制命令",
          "pathParams": {
            "uin": {
              "label": "机器人UIN",
              "placeholder": "123456789",
              "defaultValue": "123456789"
            }
          },
          "bodyParams": [
            {
              "name": "action",
              "label": "操作类型",
              "type": "select",
              "required": true,
              "options": [
                {
                  "value": "shutdown",
                  "label": "关机"
                },
                {
                  "value": "startup",
                  "label": "开机"
                }
              ],
              "defaultValue": "shutdown"
            }
          ]
        },
        {
          "id": "message-send",
          "method": "POST",
          "path": "/api/message/send",
          "title": "发送消息",
          "description": "向好友或群组发送消息",
          "bodyParams": [
            {
              "name": "bot_id",
              "label": "机器人ID",
              "type": "text",
              "placeholder": "留空使用默认机器人",
              "defaultValue": "留空使用默认机器人"
            },
            {
              "name": "type",
              "label": "消息类型",
              "type": "select",
              "required": true,
              "options": [
                {
                  "value": "private",
                  "label": "私聊"
                },
                {
                  "value": "group",
                  "label": "群聊"
                }
              ],
              "defaultValue": "group"
            },
            {
              "name": "target_id",
              "label": "目标ID",
              "type": "text",
              "required": true,
              "placeholder": "好友QQ或群号",
              "defaultValue": "123456789"
            },
            {
              "name": "message",
              "label": "消息内容",
              "type": "textarea",
              "required": true,
              "placeholder": "输入消息内容",
              "defaultValue": "你好，这是一条测试消息！"
            }
          ]
        }
      ]
    },
    {
      "id": "stdin",
      "title": "标准输入",
      "apis": [
        {
          "id": "stdin-command",
          "method": "POST",
          "path": "/api/stdin/command",
          "title": "发送命令",
          "description": "通过标准输入发送命令到机器人系统",
          "bodyParams": [
            {
              "name": "command",
              "label": "命令内容",
              "type": "textarea",
              "required": true,
              "placeholder": "输入命令",
              "defaultValue": "#更新"
            },
            {
              "name": "user_info",
              "label": "用户信息",
              "type": "json",
              "placeholder": "{\"user_id\": \"web_api_user\"}",
              "defaultValue": {
                "user_id": "web_api_user",
                "nickname": "Web API 用户"
              }
            },
            {
              "name": "json",
              "label": "返回JSON结果",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是（按插件输出结构化返回）"
                },
                {
                  "value": "false",
                  "label": "否（仅返回基础执行结果）"
                }
              ],
              "defaultValue": "true"
            }
          ]
        },
        {
          "id": "stdin-event",
          "method": "POST",
          "path": "/api/stdin/event",
          "title": "触发事件",
          "description": "创建自定义事件触发插件响应",
          "bodyParams": [
            {
              "name": "event_type",
              "label": "事件类型",
              "type": "text",
              "required": true,
              "placeholder": "message",
              "defaultValue": "message"
            },
            {
              "name": "content",
              "label": "事件内容",
              "type": "json",
              "required": true,
              "placeholder": "{\"message\": \"测试\"}",
              "defaultValue": {
                "message": [
                  {
                    "type": "text",
                    "text": "你好"
                  }
                ]
              }
            },
            {
              "name": "user_info",
              "label": "用户信息",
              "type": "json",
              "defaultValue": {
                "user_id": "web_api_user",
                "nickname": "Web API 用户"
              }
            },
            {
              "name": "json",
              "label": "返回 JSON",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是"
                },
                {
                  "value": "false",
                  "label": "否"
                }
              ],
              "defaultValue": "true"
            }
          ]
        },
        {
          "id": "stdin-status",
          "method": "GET",
          "path": "/api/stdin/status",
          "title": "Stdin状态",
          "description": "获取标准输入处理器的状态信息"
        }
      ]
    },
    {
      "id": "ai",
      "title": "AI 功能",
      "apis": [
        {
          "id": "ai-models",
          "method": "GET",
          "path": "/api/ai/models",
          "title": "AI 模型列表",
          "description": "控制台 LLM 目录（vendors / workflows；需 API Key）"
        },
        {
          "id": "v1-models",
          "method": "GET",
          "path": "/v1/models",
          "title": "OpenAI 模型列表",
          "description": "OpenAI 兼容模型列表（需 API Key；与 /v1/chat/completions 搭配）"
        },
        {
          "id": "v1-chat-completions",
          "method": "POST",
          "path": "/v1/chat/completions",
          "title": "OpenAI Chat Completions",
          "description": "标准运营商 Chat Completions（需 API Key；stream 用 SSE）",
          "bodyParams": [
            {
              "name": "apiKey",
              "label": "访问密钥",
              "type": "password",
              "required": false,
              "placeholder": "访问密钥",
              "defaultValue": "demo-key",
              "hint": "可选；多数部署用顶栏 X-API-Key 即可"
            },
            {
              "name": "messages",
              "label": "消息列表",
              "type": "json",
              "required": true,
              "placeholder": "[{\"role\": \"user\", \"content\": \"你好\"}]",
              "defaultValue": [
                {
                  "role": "user",
                  "content": "你好"
                }
              ]
            },
            {
              "name": "model",
              "label": "模型/提供商",
              "type": "text",
              "placeholder": "volcengine",
              "defaultValue": "volcengine"
            },
            {
              "name": "stream",
              "label": "流式输出",
              "type": "select",
              "options": [
                {
                  "value": "false",
                  "label": "否"
                },
                {
                  "value": "true",
                  "label": "是"
                }
              ],
              "defaultValue": "false"
            }
          ]
        },
        {
          "id": "v1-messages",
          "method": "POST",
          "path": "/v1/messages",
          "title": "Anthropic Messages",
          "description": "Anthropic Messages API（需 API Key）"
        },
        {
          "id": "v1-responses",
          "method": "POST",
          "path": "/v1/responses",
          "title": "OpenAI Responses",
          "description": "OpenAI Responses API（需 API Key；store=false）"
        }
      ]
    },
    {
      "id": "config",
      "title": "配置管理",
      "apis": [
        {
          "id": "config-list",
          "method": "GET",
          "path": "/api/config/list",
          "title": "配置列表",
          "description": "获取所有配置文件列表"
        },
        {
          "id": "config-structure",
          "method": "GET",
          "path": "/api/config/:name/structure",
          "title": "配置结构",
          "description": "获取配置文件的 Schema 结构",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          }
        },
        {
          "id": "config-flat-structure",
          "method": "GET",
          "path": "/api/config/:name/flat-structure",
          "title": "扁平化结构",
          "description": "获取配置文件的扁平化 Schema 结构（Schema）",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "queryParams": [
            {
              "name": "path",
              "label": "配置路径",
              "type": "text",
              "placeholder": "log_level",
              "defaultValue": "log_level"
            }
          ]
        },
        {
          "id": "config-flat",
          "method": "GET",
          "path": "/api/config/:name/flat",
          "title": "扁平化数据",
          "description": "获取配置文件当前值的扁平化数据",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "queryParams": [
            {
              "name": "path",
              "label": "配置路径",
              "type": "text",
              "placeholder": "log_level",
              "defaultValue": "log_level"
            }
          ]
        },
        {
          "id": "config-read",
          "method": "GET",
          "path": "/api/config/:name/read",
          "title": "读取配置",
          "description": "读取指定配置文件（或子配置）的内容",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "queryParams": [
            {
              "name": "path",
              "label": "配置路径",
              "type": "text",
              "placeholder": "log_level",
              "defaultValue": "log_level"
            }
          ]
        },
        {
          "id": "config-write",
          "method": "POST",
          "path": "/api/config/:name/write",
          "title": "写入配置",
          "description": "写入配置到指定文件或子配置",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "bodyParams": [
            {
              "name": "data",
              "label": "配置数据",
              "type": "json",
              "required": true,
              "placeholder": "{\"log_level\": \"info\"}",
              "defaultValue": {
                "log_level": "info"
              }
            },
            {
              "name": "path",
              "label": "配置路径",
              "type": "text",
              "placeholder": "log_level",
              "defaultValue": "log_level"
            },
            {
              "name": "backup",
              "label": "是否备份",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是"
                },
                {
                  "value": "false",
                  "label": "否"
                }
              ],
              "defaultValue": "true"
            }
          ]
        },
        {
          "id": "config-batch-set",
          "method": "POST",
          "path": "/api/config/:name/batch-set",
          "title": "批量设置",
          "description": "批量设置配置项（扁平化 path => value）",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "bodyParams": [
            {
              "name": "flat",
              "label": "扁平化数据",
              "type": "json",
              "required": true,
              "placeholder": "{\"log_level\": \"info\"}",
              "defaultValue": {
                "log_level": "info"
              }
            },
            {
              "name": "path",
              "label": "（可选）子配置名称",
              "type": "text",
              "placeholder": "log",
              "defaultValue": "log"
            },
            {
              "name": "backup",
              "label": "是否备份",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是"
                },
                {
                  "value": "false",
                  "label": "否"
                }
              ],
              "defaultValue": "true"
            }
          ]
        },
        {
          "id": "config-validate",
          "method": "POST",
          "path": "/api/config/:name/validate",
          "title": "校验配置",
          "description": "根据 Schema 校验配置数据是否有效（不落盘）",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "bodyParams": [
            {
              "name": "data",
              "label": "待校验数据",
              "type": "json",
              "required": true,
              "placeholder": "{\"log_level\": \"debug\"}",
              "defaultValue": {
                "log_level": "debug"
              }
            }
          ]
        },
        {
          "id": "config-backup",
          "method": "POST",
          "path": "/api/config/:name/backup",
          "title": "备份配置文件",
          "description": "为指定配置生成一份备份文件",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          }
        },
        {
          "id": "config-reset",
          "method": "POST",
          "path": "/api/config/:name/reset",
          "title": "重置为默认值",
          "description": "将配置重置为默认值（可选是否备份）",
          "pathParams": {
            "name": {
              "label": "配置名称",
              "placeholder": "system",
              "defaultValue": "system"
            }
          },
          "bodyParams": [
            {
              "name": "backup",
              "label": "是否备份当前值",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "是"
                },
                {
                  "value": "false",
                  "label": "否"
                }
              ],
              "defaultValue": "true"
            }
          ]
        },
        {
          "id": "config-clear-cache",
          "method": "POST",
          "path": "/api/config/clear-cache",
          "title": "清除配置缓存",
          "description": "清除所有配置文件在内存中的缓存"
        }
      ]
    },
    {
      "id": "device",
      "title": "设备管理",
      "apis": [
        {
          "id": "device-register",
          "method": "POST",
          "path": "/api/device/register",
          "title": "注册设备",
          "description": "注册新的物联网设备到系统",
          "bodyParams": [
            {
              "name": "device_id",
              "label": "设备ID",
              "type": "text",
              "required": true,
              "placeholder": "DEVICE_001",
              "defaultValue": "SENSOR_001"
            },
            {
              "name": "device_type",
              "label": "设备类型",
              "type": "text",
              "required": true,
              "placeholder": "sensor",
              "defaultValue": "sensor"
            },
            {
              "name": "device_name",
              "label": "设备名称",
              "type": "text",
              "placeholder": "温度传感器",
              "defaultValue": "温湿度传感器"
            },
            {
              "name": "capabilities",
              "label": "设备能力",
              "type": "json",
              "placeholder": "[\"temperature\"]",
              "defaultValue": [
                "temperature"
              ]
            }
          ]
        },
        {
          "id": "device-list",
          "method": "GET",
          "path": "/api/devices",
          "title": "设备列表",
          "description": "获取所有注册的物联网设备"
        },
        {
          "id": "device-detail",
          "method": "GET",
          "path": "/api/device/:deviceId",
          "title": "设备详情",
          "description": "获取指定设备的详细信息",
          "pathParams": {
            "deviceId": {
              "label": "设备ID",
              "placeholder": "DEVICE_001",
              "defaultValue": "SENSOR_001"
            }
          }
        },
        {
          "id": "device-ai",
          "method": "POST",
          "path": "/api/device/:deviceId/ai",
          "title": "设备AI回复",
          "description": "触发设备工作流，执行AI并驱动表情/TTS",
          "pathParams": {
            "deviceId": {
              "label": "设备ID",
              "placeholder": "webclient",
              "defaultValue": "webclient"
            }
          },
          "bodyParams": [
            {
              "name": "text",
              "label": "问题/文本",
              "type": "textarea",
              "required": true,
              "placeholder": "你好",
              "defaultValue": "你好"
            },
            {
              "name": "workflow",
              "label": "工作流",
              "type": "text",
              "placeholder": "device",
              "defaultValue": "device"
            }
          ]
        },
        {
          "id": "device-asr-sessions",
          "method": "GET",
          "path": "/api/device/:deviceId/asr/sessions",
          "title": "ASR 会话列表",
          "description": "查看指定设备当前活跃的语音识别会话",
          "pathParams": {
            "deviceId": {
              "label": "设备ID",
              "placeholder": "DEVICE_001",
              "defaultValue": "SENSOR_001"
            }
          }
        },
        {
          "id": "device-asr-recordings",
          "method": "GET",
          "path": "/api/device/:deviceId/asr/recordings",
          "title": "ASR 录音列表",
          "description": "查看指定设备已保存的录音文件",
          "pathParams": {
            "deviceId": {
              "label": "设备ID",
              "placeholder": "DEVICE_001",
              "defaultValue": "SENSOR_001"
            }
          }
        },
        {
          "id": "device-tts",
          "method": "POST",
          "path": "/api/device/tts",
          "title": "设备TTS播报",
          "description": "调用设备 TTS 为指定设备播放一段文字",
          "bodyParams": [
            {
              "name": "device_id",
              "label": "设备ID",
              "type": "text",
              "required": true,
              "placeholder": "DEVICE_001",
              "defaultValue": "SENSOR_001"
            },
            {
              "name": "text",
              "label": "播报文本",
              "type": "textarea",
              "required": true,
              "placeholder": "你好，这是一条测试播报",
              "defaultValue": "你好，这是一条测试播报"
            }
          ]
        },
        {
          "id": "device-file",
          "method": "GET",
          "path": "/api/device/file/:fileId",
          "title": "设备文件访问",
          "description": "通过后端生成的 fileId 访问设备相关的本地文件（只读）",
          "pathParams": {
            "fileId": {
              "label": "文件ID（base64url）",
              "placeholder": "ZzpcZGF0YVxkZXZpY2VcYTku...",
              "defaultValue": "ZzpcZGF0YVxkZXZpY2VcZmlsZS5wbmc"
            }
          }
        },
        {
          "id": "trash-file",
          "method": "GET",
          "path": "/api/trash/:relPath",
          "title": "临时文件访问",
          "description": "读取回收站内文件（相对路径）",
          "pathParams": {
            "relPath": {
              "label": "相对路径",
              "placeholder": "example.png",
              "defaultValue": "example.png"
            }
          }
        }
      ]
    },
    {
      "id": "file",
      "title": "文件管理",
      "apis": [
        {
          "id": "file-upload",
          "method": "POST",
          "path": "/api/file/upload",
          "title": "上传文件",
          "description": "上传文件到服务器（multipart/form-data，字段名 file）",
          "requestType": "multipart",
          "fileField": "file",
          "multiple": true
        },
        {
          "id": "file-get",
          "method": "GET",
          "path": "/api/file/:id",
          "title": "获取文件",
          "description": "通过文件ID获取文件内容",
          "pathParams": {
            "id": {
              "label": "文件ID",
              "placeholder": "file_id",
              "defaultValue": "example-file-id"
            }
          },
          "queryParams": [
            {
              "name": "download",
              "label": "下载模式",
              "type": "select",
              "options": [
                {
                  "value": "false",
                  "label": "预览"
                },
                {
                  "value": "true",
                  "label": "下载"
                }
              ],
              "defaultValue": "false"
            }
          ]
        },
        {
          "id": "file-delete",
          "method": "DELETE",
          "path": "/api/file/:id",
          "title": "删除文件",
          "description": "删除已上传的文件",
          "pathParams": {
            "id": {
              "label": "文件ID",
              "placeholder": "file_id",
              "defaultValue": "example-file-id"
            }
          }
        },
        {
          "id": "file-list",
          "method": "GET",
          "path": "/api/files",
          "title": "文件列表",
          "description": "获取所有已上传的文件列表"
        }
      ]
    },
    {
